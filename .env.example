# ─────────────────────────────────────────────────────────────
#  Пример переменных окружения.
#  Скопируй в .env:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# --- Для локального запуска БЕЗ Docker ---
# (в docker-стеке эти значения задаются автоматически в docker-compose.yml
#  и указывают на сервисы db/redis, а не на localhost)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/employee_management
REDIS_URL=redis://localhost:6379/0

# --- Переопределение параметров docker-стека (необязательно) ---
# Docker Compose подхватывает эти значения для сервиса db.
POSTGRES_DB=employee_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Учётка администратора (создаётся автоматически при старте) ---
ADMIN_EMAIL=admin@mail.ru
ADMIN_PASSWORD=12345
ADMIN_NAME=Admin

# --- Мобильный API ---
# Ключ подписи JWT-токенов. В продакшене замени на длинный случайный.
JWT_SECRET=dev-insecure-change-me-in-production
# Срок жизни токена в минутах (по умолчанию 7 дней = 10080)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Кэш дашборда (Redis) ---
# Время жизни закэшированных агрегатов в секундах (по умолчанию 1 час)
CACHE_TTL_SECONDS=3600
